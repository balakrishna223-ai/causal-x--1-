# CAUSAL-X Environment Configuration Template
# Copy this file to .env before running Docker Compose or local services.
# NEVER commit real secrets to version control.

# ---------------------------------------------------------------------------
# Central Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=causalx
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=causalx_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://causalx:change-me-postgres-password@postgres:5432/causalx_db

# Local non-Docker backend database URL example:
# DATABASE_URL=postgresql+psycopg://causalx:change-me-postgres-password@localhost:5432/causalx_db

# ---------------------------------------------------------------------------
# Authentication & Cryptographic Verification (Development Defaults)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-dev-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Shared HMAC secret used by collector proof engine and backend verification
COLLECTOR_HMAC_SECRET=change-me-dev-collector-hmac-secret

# Deterministic salt for pseudonymous source IDs (HMAC-SHA256)
PSEUDONYM_SALT=change-me-dev-pseudonym-salt

# ---------------------------------------------------------------------------
# Backend Platform & AIOps Settings
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=CAUSAL-X
DEFAULT_REGION=us-east-1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COLLECTOR_OFFLINE_TIMEOUT_SECONDS=60

# Configurable Anomaly Thresholds
THRESHOLD_CPU_PERCENT=90.0
THRESHOLD_MEMORY_PERCENT=90.0
THRESHOLD_LATENCY_MS=200.0
THRESHOLD_PACKET_LOSS_PERCENT=5.0

# ---------------------------------------------------------------------------
# Local Collector Configuration (Tier 1)
# ---------------------------------------------------------------------------
CAUSALX_BACKEND_URL=http://backend:8000
CAUSALX_COLLECTOR_ID=collector-local-01
CAUSALX_TENANT_SLUG=acme-cloud
CAUSALX_COLLECTOR_API_KEY=change-me-dev-collector-token
CAUSALX_COLLECTOR_POLL_SECONDS=5
CAUSALX_HEARTBEAT_SECONDS=15
CAUSALX_SQLITE_PATH=/var/lib/causalx/collector_local.db
CAUSALX_TELEMETRY_MODE=real
CAUSALX_SOURCE_TIMEZONE=UTC
CAUSALX_POLICY_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Frontend Vite Configuration
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
